{
  "name": "zebar",
  "version": "3.0.0",
  "description": "Client API for Zebar - a tool for creating customizable taskbars, desktop widgets, and popups.",
  "repository": "github:glzr-io/zebar",
  "license": "GPL-3.0-only",
  "author": "Lars Berger",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "tsx --test src/providers/glazewm/glazewm-ipc.test.ts",
    "bundle:spotcobuild-theme": "node scripts/build-spotcobuild-theme-bundle.mjs",
    "bundle:spotcobuild-theme:check": "node scripts/build-spotcobuild-theme-bundle.mjs --check",
    "pack:spotcobuild-theme:revision": "node scripts/check-spotcobuild-theme-revision.mjs",
    "pack:spotcobuild-theme:revision:check": "node scripts/check-spotcobuild-theme-revision.mjs --check",
    "dev": "pnpm build --watch src",
    "dev:local": "pnpm dev",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.0.2",
    "@tauri-apps/plugin-dialog": "2.0.0",
    "glazewm": "1.7.0",
    "luxon": "3.4.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/luxon": "3.4.2",
    "esbuild": "0.20.0",
    "tsup": "8.0.2",
    "tsx": "4.19.3",
    "typescript": "5.3.3"
  }
}
